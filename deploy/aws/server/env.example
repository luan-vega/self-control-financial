# /opt/self-control/.env  (chmod 600, dono root). Nunca faça commit deste arquivo com valores reais.
# create-db-user.sh preenche DB_URL, DB_USER e DB_PASSWORD; deploy.sh mantém IMAGE_TAG.
# Lista completa das variáveis: docs/deployment.md#variáveis-de-ambiente

# --- Imagem -------------------------------------------------------------------------------
IMAGE=ghcr.io/luan-vega/self-control-financial
IMAGE_TAG=latest

# --- App ----------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
APP_PUBLIC_URL=https://financas.seudominio.com.br
ADMIN_EMAILS=voce@exemplo.com
# 1 instância e RDS micro (~80 conexões): 5 é suficiente
DB_POOL_SIZE=5

# --- Banco (RDS) --------------------------------------------------------------------------
# sslmode=require: o RDS só aceita TLS (rds.force_ssl=1)
DB_URL=jdbc:postgresql://<endpoint-do-rds>:5432/selfcontrol?sslmode=require
DB_USER=selfcontrol
DB_PASSWORD=

# --- Cobrança -----------------------------------------------------------------------------
# mock até o Stripe estar configurado (docs/deployment.md#stripe)
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Login com Google (opcional) ------------------------------------------------------------
# Para ligar: SPRING_PROFILES_ACTIVE=prod,google
# Redirect URI no Google Cloud: https://<domínio>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- API pública (opcional) ---------------------------------------------------------------
CORS_ALLOWED_ORIGINS=
API_GOOGLE_CLIENT_IDS=
